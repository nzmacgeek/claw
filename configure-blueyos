#!/bin/sh
# configure-blueyos — convenience wrapper for cross-compiling claw against
# the BlueyOS i386 toolchain at /opt/blueyos-cross + /opt/blueyos-sysroot.
#
# Usage (from source directory):
#   ./configure-blueyos [--prefix=/ ...extra args...]
#
# Usage (VPATH build):
#   mkdir build && cd build
#   /path/to/claw/configure-blueyos [args...]
#
# The cross-toolchain and sysroot paths can be overridden via environment:
#   BLUEYOS_CROSS=/opt/blueyos-cross BLUEYOS_SYSROOT=/opt/blueyos-sysroot
#
# This wrapper passes --host=i386-blueyos-elf so that autoconf knows it is
# cross-compiling and does not attempt to execute test binaries.
# All other auto-detection (CC, specs, sysroot) is performed by configure.

set -e

# Locate the real configure script (handles both in-source and VPATH calls)
script_dir="$(cd "$(dirname "$0")" && pwd)"
configure="$script_dir/configure"

if [ ! -x "$configure" ]; then
    echo "configure-blueyos: cannot find $configure" >&2
    echo "Run autoreconf -fi in the source directory first." >&2
    exit 1
fi

exec "$configure" \
    --host=i386-blueyos-elf \
    --enable-static-binary \
    "$@"
